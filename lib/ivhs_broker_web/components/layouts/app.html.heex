<div class="min-h-screen">
  <header class="border-b-4 border-ink bg-surface">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">
      <a href="#" class="group flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center border-2 border-ink bg-success shadow-[3px_3px_0_theme(colors.ink)]">
          <span class="text-lg font-black">IV</span>
        </div>
        <div>
          <div class="text-lg font-black uppercase tracking-[0.18em]">iVHS</div>
          <div class="text-[10px] font-bold uppercase tracking-[0.25em] text-ink/60">
            Administration
          </div>
        </div>
      </a>
      <nav class="hidden items-center gap-1 sm:flex">
        <%= for %{name: name, link: link} <- nav() do %>
          <.link
            navigate={link}
            class={
              Box.Html.class(
                "border-2 px-4 py-2 text-xs font-black uppercase tracking-wider",
                [
                  {String.starts_with?(@current_path, link), "border-ink bg-ink text-paper",
                   "border-transparent hover:border-ink hover:bg-paper"}
                ]
              )
            }
          >
            {name}
          </.link>
        <% end %>
      </nav>
    </div>
    <nav class="flex border-t-2 border-ink sm:hidden">
      <%= for %{name: name, link: link} <- nav() do %>
        <.link
          navigate={link}
          class={
            Box.Html.class(
              "flex-1 px-2 py-3 text-center text-[10px] font-black uppercase",
              [
                {String.starts_with?(@current_path, link), "bg-ink text-paper", "hover:bg-paper"}
              ]
            )
          }
        >
          {name}
        </.link>
      <% end %>
    </nav>
  </header>
  <!-- Main -->
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:py-10">
    <div class="mb-5">
      {render_slot(@inner_block)}
    </div>

    <div class="text-right text-xs text-gray-400 font-mono flex justify-between uppercase">
      <div>iVHS Broker</div>
      <div>{Application.spec(:ivhs_broker)[:vsn]}</div>
    </div>
    {Phoenix.Component.live_render(@socket, IvhsBrokerWeb.Components.Notifications,
      id: "notifications",
      session: %{"session_id" => @session_id}
    )}
  </main>
</div>
